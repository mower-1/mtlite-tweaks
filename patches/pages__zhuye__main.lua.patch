+--登录态判断：Discuz 的登录 cookie 是 xxx_auth，登出后会被写成 deleted
+function Cookie已登录(ck)
+  if type(ck) ~= "string" or ck == "" then return false end
+  local 值 = ck:match("[%w_]+_auth=([^;]*)")
+  if not 值 then return false end
+  值 = 值:gsub("%s", "")
+  return 值 ~= "" and 值 ~= "deleted"
+end
