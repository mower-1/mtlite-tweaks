+function 注入私信增强()
+  if not 私信自动重发开关() then
+    return false
+  end
+  local 状态 = 私信状态()
+  local now = 毫秒()
+  -- 超过 1 小时的排队消息不再自动发（隔了很久突然发出去更奇怪）
+  local 保留 = {}
+  for _, it in ipairs(状态.q) do
+    if (tonumber(it.d) or 0) > now - 3600000 then table.insert(保留, it) end
+  end
+  if #保留 ~= #状态.q then
+    状态.q = 保留
+    重排队列(状态)
+    私信保存(状态)
+  end
+  local ok = pcall(function()
+    加载Js("window.__mlitePmCfg=" .. 队列json(状态) .. ";window.__mlitePmCfg.auto=1;")
+    加载Js(私信脚本)
+    私信推送()
+  end)
+  if not ok then print("私信增强注入失败") end
+  私信开始轮询()
+  return ok
+end
