+  }
+  buildWords();
+
+  /* ---------------- 评论屏蔽 ---------------- */
+  function ensureStyle() {
+    if (byId('mlite-style')) return;
+    var s = D.createElement('style');
+    s.id = 'mlite-style';
+    s.textContent = '.comiis_postli[data-mlite-blocked]{display:none !important;}';
+    (D.head || D.documentElement).appendChild(s);
