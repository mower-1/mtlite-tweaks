+-- 屏蔽词编辑框
+function 屏蔽词编辑对话框(保存回调)
+  local 视图 = {
+    LinearLayout,
+    layout_width = "match",
+    orientation = 1,
+    padding = "16dp",
+    {
+      TextView,
+      text = "每行一条正则，包含即命中（如 看看|谢谢）。已预置常见水贴词正则。单条评论超过 10 个字不屏蔽；纯字母/数字/符号（不含 .）会直接屏蔽；楼主帖和回复别人的楼层不参与。",
+      textSize = "12sp",
+      textColor = 副文本色,
+    },
+    {
+      TextInputLayout,
+      id = "屏蔽词输入布局",
+      layout_width = "match",
+      layout_height = "wrap",
+      layout_marginTop = "10dp",
+      hint = "屏蔽词",
+      {
+        TextInputEditText,
+        id = "屏蔽词输入框",
+        text = 屏蔽词拼接文本(),
+        layout_width = "match",
+        layout_height = "220dp",
+        gravity = "top|left",
+        textSize = "14sp",
+      },
+    },
+  }
+  local 对话框 = AlertDialog.Builder(activity)
+  .setTitle("评论屏蔽词")
+  .setView(loadlayout(视图))
+  .setPositiveButton("保存", nil)
+  .setNegativeButton("取消", nil)
+  .setNeutralButton("清空", nil)
+  .show()
+  task(200, function()
+    local Context = luajava.bindClass("android.content.Context")
+    import "android.view.inputmethod.InputMethodManager"
+    pcall(function()
+      屏蔽词输入框.getContext().getSystemService(Context.INPUT_METHOD_SERVICE)
+      .toggleSoftInput(0, InputMethodManager.HIDE_NOT_ALWAYS)
+      屏蔽词输入框.requestFocus()
+    end)
+  end)
+  对话框.getButton(AlertDialog.BUTTON1).onClick = function()
+    local 文本 = ""
+    if 屏蔽词输入框 and 屏蔽词输入框.text then
+      文本 = tostring(屏蔽词输入框.text)
+    end
+    存储应用数据("评论屏蔽词", 文本)
+    对话框.dismiss()
+    if 保存回调 then
+      保存回调(屏蔽词数量文本())
+    end
+  end
+  对话框.getButton(AlertDialog.BUTTON2).onClick = function()
+    对话框.dismiss()
+  end
+  对话框.getButton(AlertDialog.BUTTON3).onClick = function()
+    存储应用数据("评论屏蔽词", "")
+    对话框.dismiss()
+    if 保存回调 then
+      保存回调(屏蔽词数量文本())
+    end
+  end
+end
