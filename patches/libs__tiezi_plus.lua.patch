+-- ============================ 屏蔽词处理 ============================
+
+function 屏蔽词列表()
+  local 结果 = {}
+  local 文本 = 获取应用数据("评论屏蔽词")
+  if not 文本 or 文本 == "" then
+    return 结果
+  end
+  for 行 in 文本:gmatch("[^\r\n]+") do
+    行 = 行:gsub("　", "")          -- 全角空格按整串去掉，避免多字节被截断
+    行 = 行:gsub("^%s+", ""):gsub("%s+$", "")
+    if 行 == "" then
+      -- 空行跳过
+     elseif 行:find("[|%(%)%[%]{}%^%$%.%*%+%?\\]") then
+      -- 含正则符号：整行当成一条正则，不能再按逗号切开（会破坏 {2,3} 之类）
+      table.insert(结果, 行)
+     else
+      for 词 in 行:gmatch("[^，,；;、]+") do
+        词 = 词:gsub("^%s+", ""):gsub("%s+$", "")
+        if 词 ~= "" then
+          table.insert(结果, 词)
+        end
+      end
+    end
+  end
+  return 结果
+end
+
+-- 内置词表定义在 gongyong.lua（首次运行会作为一条正则写进屏蔽词设置），这里只做统计
