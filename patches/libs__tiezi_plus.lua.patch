+  function buildWords() {
+    W = [];
+    var a = CFG.words || [], i, w, re;
+    for (i = 0; i < a.length; i++) {
+      w = String(a[i]).replace(/^\s+|\s+$/g, '');
+      if (!w) continue;
+      re = null;
+      try { re = new RegExp(w, 'i'); } catch (e) { re = null; }  /* 非法正则退化为包含匹配 */
+      W.push({ raw: w, re: re });
