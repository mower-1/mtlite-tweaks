+           f.querySelector('[id^="postmessage_"]') || f;
+  }
+  /* 纯正文：把引用块（回复别人时带上的原话）去掉，避免它撑长文本、也避免误判 */
+  function bodyText(f, keepQuote) {
+    var el = bodyOf(f), t = txt(el), i, qs;
+    if (!keepQuote && el.querySelectorAll) {
+      qs = el.querySelectorAll('.comiis_quote');
