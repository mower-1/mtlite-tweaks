+  /* 楼主帖：comiis 模板独有 comiis_postli_topv1 / comiis_pltit 标记 */
+  function isOP(f) {
+    return !!(f.querySelector('.comiis_postli_topv1') || f.querySelector('.comiis_pltit'));
+  }
+  function pidOf(el) {
+    var m = (el.id || '').match(/^pid(\d+)$/);
+    if (m) return m[1];
