+  if type(内置屏蔽词列表) == "function" then
+    return 内置屏蔽词列表()
+  end
+  return {}
+end
+
+function 屏蔽词数量文本()
+  local 数量 = #屏蔽词列表()
+  if 数量 == 0 then
+    return "未设置"
+  end
+  return 数量 .. " 个屏蔽词"
+end
+
+function 屏蔽词拼接文本()
+  return 获取应用数据("评论屏蔽词") or ""
+end
+
+function 初始化并行页数()
+  local v = tonumber(获取应用数据("并行加载页数") or "")
+  if not v or v < 1 or v > 4 then
+    存储应用数据("并行加载页数", "2")
+    v = 2
+  end
+  return v
+end
