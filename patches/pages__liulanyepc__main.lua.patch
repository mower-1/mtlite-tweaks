+function 应用浏览模式(是否电脑版)
+  当前电脑版=是否电脑版
+  local ua=是否电脑版 and 获取应用数据("电脑UA") or 获取应用数据("手机UA")
+  local function 套(b)
+    pcall(function()
+      local 设置=b.getSettings()
+      设置.setUserAgentString(ua)
+      设置.setUseWideViewPort(是否电脑版)
+      设置.setLoadWithOverviewMode(是否电脑版)
+    end)
+  end
+  pcall(function() 套(获取浏览器()) end)
